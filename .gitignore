data/**/*.jsonl
scripts/ssh/
configs/local_resources.yaml
prompt.txt
# Transient Hugging Face/Arrow caches remain private as well.
data/raw/**/.cache/

# Keep empty directories/documentation
!data/**/.gitkeep
!outputs/.gitkeep
!reports/generated/.gitkeep
